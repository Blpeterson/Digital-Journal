{
  "name": "lined-notebook",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop notebook that feels like paper.",
  "main": "dist/src/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && playwright test --config playwright.electron.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@tiptap/extension-color": "^3.7.2",
    "@tiptap/extension-text-style": "^3.7.2",
    "@tiptap/extension-underline": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "org.opensource.linednotebook",
    "productName": "Lined Notebook",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packages/assets/LICENSES.md",
        "to": "licenses/ASSETS.md"
      },
      {
        "from": "node_modules/@fontsource/lora/LICENSE",
        "to": "licenses/fonts/Lora-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/nunito/LICENSE",
        "to": "licenses/fonts/Nunito-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/atkinson-hyperlegible/LICENSE",
        "to": "licenses/fonts/Atkinson-Hyperlegible-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/caveat/LICENSE",
        "to": "licenses/fonts/Caveat-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/dancing-script/LICENSE",
        "to": "licenses/fonts/Dancing-Script-OFL.txt"
      },
      {
        "from": "node_modules/@fontsource/pacifico/LICENSE",
        "to": "licenses/fonts/Pacifico-OFL.txt"
      }
    ],
    "mac": {
      "minimumSystemVersion": "11.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS-11-universal.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
